apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
- token: "{{ bootstrap_token.stdout }}"
  description: "kubeadm bootstrap token"
  ttl: "24h"
nodeRegistration:
  criSocket: "unix:///var/run/containerd/containerd.sock"
  kubeletExtraArgs:
  - name: node-ip
    value: {{ hostvars[inventory_hostname]['ansible_default_ipv4']['address'] }}
localAPIEndpoint:
  advertiseAddress: {{ hostvars[inventory_hostname]['ansible_default_ipv4']['address'] }}
  bindPort: 6443
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
controllerManager:
  extraArgs:
  - name: bind-address
    value: "0.0.0.0" # Used by Prometheus Operator
scheduler:
  extraArgs:
  - name: bind-address
    value: "0.0.0.0" # Used by Prometheus Operator
apiServer:
  certSANs:
  - "{{ hostvars[inventory_hostname]['ansible_default_ipv4']['address'] }}"
  - "{{ control_plane_ip }}"
controlPlaneEndpoint: "{{ control_plane_ip }}:6443"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: "systemd"
protectKernelDefaults: true
